# ScytaleDroid Environment (example)
#
# Copy to `.env` at repo root. Alternate path: set SCYTALEDROID_ENV_FILE (see `run_mariadb.sh`).
# Precedence: variables already set in the shell are NOT overwritten by `.env` (see db_config._load_dotenv).
#
# Password naming (canonical):
#   SCYTALEDROID_DB_PASSWD — primary MariaDB (matches Python db_config; **SCYTALEDROID_DB_PASS is legacy** — do not use for new setups).
#   SCYTALEDROID_PERMISSION_INTEL_DB_PASSWD — Permission Intel DB (**there is no …_PASS**).
# If SCYTALEDROID_PERMISSION_INTEL_DB_URL is set (non-empty), it overrides split HOST/USER/PASSWD/… for Intel.

# ---- Primary operational database (MariaDB/MySQL) ----
SCYTALEDROID_DB_HOST=localhost
SCYTALEDROID_DB_PORT=3306
SCYTALEDROID_DB_NAME=scytaledroid_core_prod
SCYTALEDROID_DB_USER=scytaledroid_operator
SCYTALEDROID_DB_PASSWD=
SCYTALEDROID_DB_SCHEME=mysql

# Optional single DSN (otherwise built from SCYTALEDROID_DB_* above).
# SCYTALEDROID_DB_URL=mysql://scytaledroid_operator:change-me@localhost:3306/scytaledroid_core_prod

# DB menu "Write DB schema snapshot": default uses information_schema row estimates (one query).
# Set to 1 for legacy per-table SELECT COUNT(*) (slow on large catalogs; compliance / exact audits).
# SCYTALEDROID_DB_SCHEMA_SNAPSHOT_EXACT_TABLE_COUNTS=1

# API server authentication is required by default. Generate a unique local
# secret for `.env`; the documented placeholder value `change-me` is rejected.
SCYTALEDROID_API_KEY=
# Development/test-only unauthenticated API mode. Requires SCYTALEDROID_ENV to
# be `test` or `development` and is restricted to loopback API hosts.
# SCYTALEDROID_API_AUTH_DISABLED=1
# SCYTALEDROID_ENV=development

# Legacy publication/export path toggle (default off).
SCYTALEDROID_ENABLE_LEGACY_PUBLICATION=0

# ---- Global runtime mode ----
# physical | virtual | validation — see run.sh / app_config
SCYTALEDROID_RUNTIME_PRESET=physical
SCYTALEDROID_DEBUG_MODE=False
SCYTALEDROID_EXECUTION_MODE=PROD
SCYTALEDROID_SYS_ENV=PHYSICAL
SCYTALEDROID_SYS_TEST=False

# ---- Terminal UI (ANSI themes) ----
# Theme preset: blackhat-night | aurora | fedora-dark | fedora-light | ember | high-contrast
# SCYTALEDROID_UI_THEME is read first; if unset, SCYTALE_UI_THEME is used.
# SCYTALEDROID_UI_THEME=ember
# SCYTALE_UI_THEME=aurora
# SCYTALE_UI_HIGH_CONTRAST=1
# ASCII_UI=1

# ---- Static analysis paper grade ----
# 1 = canonical paper-grade path (Permission Intel + governance snapshots expected).
# 0 = experimental (no paper-grade gate messaging).
SCYTALEDROID_CANONICAL_GRADE=1

# Persist static findings to MariaDB when true (default on). Preflight prints skipped vs enabled.
# SCYTALEDROID_PERSISTENCE_READY=0

# Legacy mirror writers removed; static persistence uses static_analysis_* only.
# When unset: ``fetch_db_masvs_summary(None)`` uses latest ``static_analysis_runs`` only (no ``runs`` table);
# a non-null ``run_id`` argument is treated as ``static_analysis_runs.id`` (canonical), not legacy ``findings``.
# When set: ``None`` may fall back to ``runs``/``findings``; explicit ``run_id`` may resolve via ``findings``.
# SCYTALEDROID_ALLOW_LEGACY_MASVS_FALLBACK=1

# ---- Permission Intel (ScytaleDroid: dictionary + governance; NOT the core static-results DB) ----
# Canonical catalog name for this framework: **android_permission_intel** (MariaDB schema/database).
# ScytaleDroid reads/writes these tables only via SCYTALEDROID_PERMISSION_INTEL_DB_* (or …_URL).
SCYTALEDROID_PERMISSION_INTEL_DB_HOST=localhost
SCYTALEDROID_PERMISSION_INTEL_DB_PORT=3306
SCYTALEDROID_PERMISSION_INTEL_DB_NAME=android_permission_intel
SCYTALEDROID_PERMISSION_INTEL_DB_USER=scytaledroid_operator
SCYTALEDROID_PERMISSION_INTEL_DB_PASSWD=

# Optional Intel DSN (overrides split vars when non-empty). Path must end with database android_permission_intel
# unless you intentionally use a non-standard catalog name (then align check_permission_intel / doctor output).
# SCYTALEDROID_PERMISSION_INTEL_DB_URL=mysql://user:pass@localhost:3306/android_permission_intel

# Erebus is separate tooling with its **own** database connection (EREBUS_* env vars, different catalog).
# Do not point ScytaleDroid Permission Intel vars at Erebus’s DB, or vice versa, unless you explicitly
# intend one server to host both schemas — still keep env prefixes separate per process.

# Static progress cadence (milestones every N artifacts)
SCYTALEDROID_STATIC_PROGRESS_EVERY=5

# Canonical findings evidence: when unset/1/true, persist full JSON in ``static_analysis_findings.evidence``
# alongside ``evidence_hash`` (transition / rollback). Set to 0/false to omit inline JSON when a payload row exists.
# SCYTALEDROID_FINDINGS_EVIDENCE_INLINE=0

# After a successful static run: compact session grain + archive JSON count (read-only SQL).
# unset / empty = auto (emit when batch OR noninteractive); 1 = always; 0 = never.
# SCYTALEDROID_STATIC_POST_RUN_GRAIN_SUMMARY=1

# Parallel static analyze_apk within one package (split APKs). Default unset / 1 = serial only.
# Capped by resolved worker budget (Workers / auto CPU) and artifact count (hard max 8).
# Persistence stays on the main thread; batch+quiet runs remain serial.
# SCYTALEDROID_STATIC_ARTIFACT_WORKERS=4

# Session evidence index (Phase 1): writes data/sessions/<session_stamp>/evidence_manifest.json after run_map.json.
# Set to 0 / false / no / off to skip (see docs/maintenance/evidence_run_manifest_spec.md §6).
# SCYTALEDROID_EVIDENCE_MANIFEST=0

# Optional build stamp for evidence_manifest.json (else CI vars GITHUB_SHA / CI_COMMIT_SHA are used when set).
# SCYTALEDROID_BUILD_ID=local-dev-20260509

# ---- New-host setup and external APK storage ----
# setup.sh does not require Android tooling on a reporting/DB-only host by default.
# Export this before setup when the host will use ADB/SDK capture workflows:
# SCYTALEDROID_SETUP_ANDROID=1
#
# Existing cold APK symlinks target the Mercury mount shown below. Keep that mount
# path on a new host, or transfer the cold store elsewhere and run the explicit
# dry-run-first retarget helper documented by the migration readiness report.
# SCYTALEDROID_MERCURY_MOUNTPOINT=/mnt/MERCURY_DATA_V2
# SCYTALEDROID_COLD_APK_STORE_ROOT=/mnt/MERCURY_DATA_V2/scytaledroid_artifacts/apk_store/cold
# SCYTALEDROID_EXTERNAL_APK_STORE_MOUNT_ROOTS=/mnt/MERCURY_DATA_V2:/mnt/MERCURY_DATA_USB

# APK harvest CLI (simple mode defaults): quieter progress milestones + omit long [COPY] from stdout (logs retain it).
# SCYTALEDROID_HARVEST_PROGRESS_EVERY=10
# SCYTALEDROID_HARVEST_COPY_LINE=1
# After canonical store materialization, replace session copies with symlinks (Unix; saves disk; default off).
# SCYTALEDROID_HARVEST_THIN_SESSION=1

# DeviceAnalysis package-manager shell user scope. Default is user 0 for physical analyst devices.
# Set to `none` to omit explicit `--user` on package-manager list/path/dumpsys package calls.
# SCYTALEDROID_ADB_PACKAGE_USER_ID=0
