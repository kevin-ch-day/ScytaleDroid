# Local and generated files. Tracked contracts such as .env.example stay in Git.
# Machine-local trees (data/, output/, logs/, evidence/) are not architecture truth.

# --- Python bytecode and caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Distribution / packaging ---
build/
dist/
wheels/
*.egg
*.egg-info/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tooling caches ---
.ruff_cache/
.mypy_cache/
.pytest_cache/
pytest_cache/
.hypothesis/
.tox/
.nox/
.benchmarks/
.cache/
.ipynb_checkpoints/

# --- Test / coverage ---
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json
nosetests.xml
pytestdebug.log

# --- IDE / editor / OS ---
.idea/
.vscode/
*.swp
*.swo
*.orig
*~
.DS_Store
Thumbs.db

# --- Secrets and local environment ---
.env
.env.*
!.env.example
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# --- Runtime / evidence trees ---
logs/
output/
data/
/evidence/
.setup/
migration-checks/

# --- Local SQL and database dumps (do not ignore tracked scripts/db/*.sql) ---
scripts/db/local_*.sql
scripts/db/*.local.sql
/backups/
/backup/
/dumps/
/dump/
/db_backups/
*.sql.gz
*.sql.xz
*.dump
*.dmp
*.sqlite
*.sqlite3

# --- Harvested / captured research payloads ---
*.apk
*.aab
*.apks
*.xapk
*.pcap
*.pcapng
*.cap

# --- Permission catalog download cache ---
scytaledroid/Utils/AndroidPermCatalog/cache/*.json
scytaledroid/Utils/AndroidPermCatalog/cache/*.csv

# --- Scratch / logs / packages ---
*.log
*.tmp
*.bak
*.rpm
teamviewer*.rpm
